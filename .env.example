# Copiar este fichero a .env y rellenar los valores.
# .env contiene credenciales reales y no debe subirse al repositorio.

# Claves de firma
SECRET_KEY=
JWT_SECRET_KEY=

# Base de datos MySQL
MYSQL_HOST=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
